{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":gitSignOff",
    ":noUnscheduledUpdates"
  ],
  "configMigration": true,
  "npm": {},
  "automerge": true,
  "automergeType": "pr",
  "autoApprove": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "* * * * 0"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "vulnerability"
    ],
    "assignees": [
      "team:platform-mesh/security"
    ],
    "reviewers": [
      "team:platform-mesh/security"
    ],
    "automerge": true,
    "platformAutomerge": true
  },
  "postUpdateOptions": [
    "gomodUpdateImportPaths",
    "gomodTidy",
    "npmInstallTwice"
  ],
  "packageRules": [
    {
      "description": "Batch non-major updates into weekly PRs, one per ecosystem.",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "Go modules",
      "groupSlug": "gomod-minor-patch",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "Container base images",
      "groupSlug": "dockerfile-minor-patch",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "Helm charts and pinned OCM component versions",
      "groupSlug": "helm-minor-patch",
      "matchManagers": [
        "helmv3",
        "helm-values",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions-minor-patch",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "groupName": "npm packages",
      "groupSlug": "npm-minor-patch",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    },
    {
      "description": "Skip automatic updates for kcp's kube fork.",
      "matchManagers": ["gomod"],
      "enabled": false,
      "matchPackageNames": [
        "github.com/kcp-dev/kubernetes{/,}**"
      ]
    },
    {
      "description": "Use replace strategy for library dependencies to convert to ranges",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "matchJsonata": [
        "$.publishConfig"
      ],
      "rangeStrategy": "replace"
    },
    {
      "description": "Pin application dependencies for reproducible production builds",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchManagers": [
        "npm"
      ],
      "matchJsonata": [
        "$.private = true and not($.publishConfig)"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Widen peer dependency ranges to support multiple versions",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "widen"
    },
    {
      "description": "Pin dev dependencies for reproducible builds",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "enabled": true,
      "bumpVersion": "patch"
    },
    {
      "groupName": "NestJS",
      "automerge": false,
      "platformAutomerge": false,
      "matchPackageNames": [
        "@nestjs/{/,}**",
        "axios{/,}**",
        "nestjs{/,}**",
        "rxjs{/,}**"
      ]
    },
    {
      "groupName": "Luigi",
      "automerge": false,
      "platformAutomerge": false,
      "matchPackageNames": [
        "@luigi-project/{/,}**"
      ]
    },
    {
      "groupName": "OpenMFP",
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": [
        "@openmfp/**"
      ]
    },
    {
      "groupName": "Platform Mesh",
      "automerge": true,
      "platformAutomerge": true,
      "matchPackageNames": [
        "@platform-mesh/**"
      ]
    },
    {
      "groupName": "Fundamental NGX and Angular",
      "automerge": false,
      "platformAutomerge": false,
      "matchPackageNames": [
        "@angular-eslint/{/,}**",
        "@angular/{/,}**",
        "@angular-devkit/{/,}**",
        "@angular-builders/{/,}**",
        "rxjs{/,}**",
        "typescript{/,}**",
        "@fundamental-ngx/{/,}**",
        "@sap-theming/theming-base-content{/,}**",
        "@ui5/webcomponents-icons{/,}**",
        "fundamental-styles{/,}**",
        "apollo-angular{/,}**",
        "ng-{/,}**",
        "ngx{/,}**",
        "jest{/,}**",
        "ts-jest{/,}**",
        "@types/jest{/,}**",
        "zone.js{/,}**"
      ]
    },
    {
      "description": "No release delay for our own reusable workflows and org Actions",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "0 days",
      "matchPackageNames": [
        "/^platform-mesh//"
      ]
    },
    {
      "groupName": "Github Actions",
      "automerge": false,
      "matchPackageNames": [
        "@actions/upload-artifact{/,}**",
        "@actions/download-artifact{/,}**"
      ]
    },
    {
      "allowedVersions": "<1.4.0",
      "matchPackageNames": [
        "k8s.io/client-go"
      ]
    },
    {
      "description": "No release delay for our own container images",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAge": "0 days",
      "matchPackageNames": [
        "ghcr.io/platform-mesh/{/,}**"
      ]
    }
  ],
  "rebaseWhen": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 0"
    ]
  }
}
